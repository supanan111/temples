# ============================================================
# Apache Configuration & Security Rules (.htaccess)
# ============================================================

DirectoryIndex index.php

# ตั้งค่า Charset เริ่มต้นเป็น UTF-8
AddDefaultCharset UTF-8

# 1. ป้องกันการเข้าถึงไฟล์ Sensitive และ Config จากภายนอก
<FilesMatch "^(\.env|\.git|.*\.sql|Dockerfile|render\.yaml|vercel\.json|\.dockerignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. ป้องกันสคริปต์ Setup สิทธิ์แอดมินบน Production (อนุญาตเฉพาะ Localhost)
<FilesMatch "^(create_admin\.php|setup_super\.php|dn_con\.php)$">
    <IfModule mod_authz_core.c>
        Require local
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
        Allow from 127.0.0.1 ::1
    </IfModule>
</FilesMatch>

# 3. ป้องกันการแสดง Directory Listing
Options -Indexes

# 4. ตั้งค่า PHP Uploads (ถ้า Apache เป็น mod_php)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value memory_limit 256M
</IfModule>

# 5. Gzip / Deflate Compression (บีบอัดข้อมูล HTML, CSS, JS, JSON ให้โหลดเร็วขึ้น 60-80%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 6. Browser Caching (แคชรูปภาพ, ฟอนต์, CSS, JS ในเครื่องผู้ใช้ ไม่ต้องดาวน์โหลดซ้ำ)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

